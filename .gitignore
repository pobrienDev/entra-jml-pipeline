# Terraform working directory (provider binaries, cached modules)
**/.terraform/*

# State — contains every attribute of every resource in plaintext, including
# tenant, subscription and identity IDs. Never commit.
*.tfstate
*.tfstate.*

# Variable files — hold tenant/subscription IDs. Only the .example is tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend config — holds the state storage account name
*.tfbackend
!*.tfbackend.example

# Saved plans are binary and embed variable values
*.tfplan
tfplan
plan.out
plan.json
plan.raw
plan.txt

# Override files are local-only by convention
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config and crash logs (crash logs can dump variable values)
.terraformrc
terraform.rc
crash.log
crash.*.log

# Credentials / env files
.env
.env.*
!.env.example
*.pem
*.pfx
*.key
.azure/

# Local settings for running Functions on a dev machine
local.settings.json

# Lab config with real values. Only the .example is tracked.
config/config.yaml

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
.python_packages/

# Logs
*.log
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it.

# Built deployment packages
dist/
